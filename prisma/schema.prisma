
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



enum UserRole {
  dono
  gestor
  fiscal
  funcionario
}

enum EventoStatus {
  rascunho
  enviado
  aprovado
  rejeitado
  exportado
}

enum ItemUnidade {
  UN
  KG
  CX
  L
}




model User {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(funcionario)
  avatarUrl    String?
  

  ativo        Boolean  @default(true)


  ownerId      String?
  owner        User?    @relation("TeamHierarchy", fields: [ownerId], references: [id])
  team         User[]   @relation("TeamHierarchy")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt


  eventosCriados   Evento[]     @relation("CriadoPor")
  eventosAprovados Evento[]     @relation("AprovadoPor")
  notasFiscais     NotaFiscal[] @relation("UploadedBy")
  evidencias       Evidencia[]  @relation("UploadedBy")
  Configuracao     Configuracao[] 

  lojaId       String?
  loja         Loja?    @relation("UserLoja", fields: [lojaId], references: [id])

  lojasPermitidas Loja[]   @relation("UserLojasPermitidas")

  lojasDono        Loja[]       @relation("LojaDono")
  categoriasLoja   Categoria[]  @relation("CategoriaDono")
  itensLoja        Item[]       @relation("ItemDono")
  eventosLoja      Evento[]     @relation("EventoDono")
  evidenciasLoja   Evidencia[]  @relation("EvidenciaDono")
  notasLoja        NotaFiscal[] @relation("NotaDono")
  motivosLoja      Motivo[]     @relation("MotivoDono")
  vendasLoja       VendaDiaria[] @relation("VendaDono")
  nfeComprasLoja   NFeCompra[]  @relation("NFeCompraDono")

  @@map("users")
}

model Loja {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("LojaDono", fields: [ownerId], references: [id])

  users        User[]        @relation("UserLoja")
  usersPermitidos User[]     @relation("UserLojasPermitidas")
  eventos      Evento[]
  vendas       VendaDiaria[]
  nfeCompras   NFeCompra[]
  evidencias   Evidencia[]
  notasFiscais NotaFiscal[]

  @@unique([nome, ownerId])
  @@map("lojas")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  status    String   @default("ativa")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("CategoriaDono", fields: [ownerId], references: [id])

  items Item[]

  @@unique([nome, ownerId])
  @@map("categorias")
}


model Item {
  id            String      @id @default(uuid())
  codigoInterno String
  codigoBarras  String?
  nome          String
  unidade       ItemUnidade @default(UN)
  custo         Decimal     @db.Decimal(10, 2)
  custoMedio    Decimal     @default(0) @db.Decimal(10, 2)
  precoVenda    Decimal     @db.Decimal(10, 2)
  imagemUrl     String?
  status        String      @default("ativo")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  ownerId     String
  owner       User   @relation("ItemDono", fields: [ownerId], references: [id])

  eventos    Evento[]
  vendaItens VendaItem[]
  fornecedores ItemFornecedor[]
  nfeCompraItens NFeCompraItem[]

  @@unique([codigoInterno, ownerId])
  @@map("items")
}


model Evento {
  id        String       @id @default(uuid())
  dataHora  DateTime
  motivo    String?
  status    EventoStatus @default(rascunho)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quantidade         Decimal @db.Decimal(10, 3)
  unidade            String
  custoSnapshot      Decimal @db.Decimal(10, 2)
  precoVendaSnapshot Decimal @db.Decimal(10, 2)
  nfeEmitida         Boolean @default(false)

  itemId String? 
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  criadoPorId String
  criadoPor   User   @relation("CriadoPor", fields: [criadoPorId], references: [id])

  aprovadoPorId String?
  aprovadoPor   User?   @relation("AprovadoPor", fields: [aprovadoPorId], references: [id])

  ownerId       String
  owner         User   @relation("EventoDono", fields: [ownerId], references: [id])

  lojaId      String?
  loja        Loja?   @relation(fields: [lojaId], references: [id])

  evidencias   Evidencia[]
  notasFiscais NotaFiscal[]

  @@map("eventos")
}


model Evidencia {
  id         String   @id @default(uuid())
  url        String 
  motivo     String?
  dataUpload DateTime @default(now())

  eventoId String? 
  evento   Evento? @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  userId String 
  user   User   @relation("UploadedBy", fields: [userId], references: [id])

  ownerId  String
  owner    User   @relation("EvidenciaDono", fields: [ownerId], references: [id])

  lojaId   String?
  loja     Loja?   @relation(fields: [lojaId], references: [id])

  @@map("evidencias")
}


model NotaFiscal {
  id           String   @id @default(uuid())
  dataUpload   DateTime @default(now())
  pdfUrl       String?
  xmlUrl       String?
  xmlContent   String? @db.Text 
  numero           String?
  serie            String?
  emitente         String?
  cnpjEmitente     String?
  dataEmissao      DateTime? 
  dataReferencia   DateTime? @map("data_referencia") 
  valorTotal       Decimal?  @db.Decimal(12, 2)
  naturezaOperacao String?
  chaveAcesso      String?
  observacoes      String?

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  eventoId String? 
  evento   Evento? @relation(fields: [eventoId], references: [id])

  ownerId    String
  owner      User   @relation("NotaDono", fields: [ownerId], references: [id])

  lojaId     String?
  loja       Loja?   @relation(fields: [lojaId], references: [id])

  @@map("notas_fiscais")
}

model Motivo {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("MotivoDono", fields: [ownerId], references: [id])

  @@unique([nome, ownerId])
  @@map("motivos")
}


model Configuracao {
  id                         String  @id @default(uuid())
  empresaNome                String  @default("Minha Empresa")
  exigirFoto                 Boolean @default(false)
  bloquearAprovados          Boolean @default(true)
  limiteDiario               Decimal @default(1000.00) @db.Decimal(10, 2)
  permitirFuncionarioGaleria Boolean @default(false)
  permissoes                 Json?

  donoId String @unique
  dono   User   @relation(fields: [donoId], references: [id])

  @@map("configuracoes")
}


model VendaDiaria {
  id             String   @id @default(uuid())
  data           DateTime 
  dataImportacao DateTime @default(now())
  
  ownerId        String
  owner          User     @relation("VendaDono", fields: [ownerId], references: [id])

  lojaId         String?
  loja           Loja?    @relation(fields: [lojaId], references: [id])

  itens          VendaItem[]

  @@map("vendas_diarias")
}

model VendaItem {
  id             String   @id @default(uuid())
  vendaDiariaId  String
  vendaDiaria    VendaDiaria @relation(fields: [vendaDiariaId], references: [id], onDelete: Cascade)
  
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  
  quantidade     Decimal  @db.Decimal(10, 3)
  valorLiquido   Decimal  @db.Decimal(10, 2)
  precoMedio     Decimal  @db.Decimal(10, 2)

  @@map("venda_itens")
}





model ItemFornecedor {
  id               String @id @default(uuid())
  codigoFornecedor String

  itemId           String
  item             Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())

  @@unique([itemId, codigoFornecedor])
  @@map("item_fornecedores")
}

model NFeCompra {
  id             String   @id @default(uuid())
  dataImportacao DateTime @default(now())
  
  numero         String?
  emitente       String?
  dataEmissao    DateTime?
  valorTotal     Decimal? @db.Decimal(12, 2)
  xmlContent     String?  @db.Text

  ownerId        String
  owner          User     @relation("NFeCompraDono", fields: [ownerId], references: [id])

  lojaId         String?
  loja           Loja?    @relation(fields: [lojaId], references: [id])

  itens          NFeCompraItem[]

  @@map("nfe_compras")
}

model NFeCompraItem {
  id                  String   @id @default(uuid())
  nfeCompraId         String
  nfeCompra           NFeCompra @relation(fields: [nfeCompraId], references: [id], onDelete: Cascade)
  
  codigoFornecedor    String?
  descricaoFornecedor String?
  unidade             String?
  quantidade          Decimal? @db.Decimal(10, 4)
  valorUnitario       Decimal? @db.Decimal(12, 4)
  valorTotal          Decimal? @db.Decimal(12, 2)

  itemId              String?
  item                Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("nfe_compra_itens")
}